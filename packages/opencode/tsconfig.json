{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      // Third-party plugin packages still declare the old scope. Point it at the
      // workspace package so there is one Plugin type, not two unrelated ones.
      "@opencode-ai/plugin": ["../plugin/src/index.ts"],
      "@opencode-ai/plugin/*": ["../plugin/src/*"]
    }
  }
}
